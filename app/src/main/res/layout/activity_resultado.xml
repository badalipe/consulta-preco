<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0B3D2E" android:gravity="center"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/txtNome"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:maxLines="3" android:text="Produto"
        android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" />
    <TextView android:id="@+id/txtPreco"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:gravity="center" android:maxLines="1"
        android:text="R$ 0,00" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="60sp" android:autoSizeMaxTextSize="220sp"
        android:textColor="#FFD600" android:textStyle="bold" />
    <TextView android:id="@+id/txtCodigo"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="Cód. -"
        android:textColor="#B0BEC5" android:textSize="18sp" />
    <Button android:id="@+id/btnNovoScan"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="40dp" android:backgroundTint="#FFFFFF"
        android:padding="20dp" android:text="📷  ESCANEAR OUTRO PRODUTO"
        android:textColor="#0B3D2E" android:textSize="22sp" android:textStyle="bold" />
</LinearLayout>
