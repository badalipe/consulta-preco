<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="250dp"
                android:centerX="50%"
                android:centerY="45%"
                android:centerColor="#003B82F6"
                android:endColor="#B30A0F1F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#000A0F1F"
                android:centerColor="#220A0F1F"
                android:endColor="#CC0A0F1F" />
        </shape>
    </item>
</layer-list>
